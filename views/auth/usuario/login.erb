<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CitasMédicas — Iniciar sesión</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<script>
(function(){
  function relLum(h,s,l){
    s/=100;l/=100;
    const k=n=>(n+h/30)%12,a=s*Math.min(l,1-l);
    const f=n=>{let x=l-a*Math.max(-1,Math.min(k(n)-3,Math.min(9-k(n),1)));return Math.max(0,Math.min(1,x))};
    const lin=c=>c<=0.04045?c/12.92:Math.pow((c+0.055)/1.055,2.4);
    return 0.2126*lin(f(0))+0.7152*lin(f(8))+0.0722*lin(f(4));
  }
  function inkSafeL(h,s){
    let lo=12,hi=64;
    while(hi-lo>0.5){const mid=(lo+hi)/2;if(relLum(h,s,mid)<=0.17)lo=mid;else hi=mid}
    return Math.round(lo);
  }
  let p={};
  try{p=JSON.parse(localStorage.getItem('ui-prefs-v2')||'{}')}catch(e){}
  const sysLight=matchMedia('(prefers-color-scheme: light)').matches;
  const h=p.h||160, s=p.s||84, L=inkSafeL(h,s);
  document.documentElement.dataset.theme=p.theme||(sysLight?'light':'dark');
  document.documentElement.style.setProperty('--h',h);
  document.documentElement.style.setProperty('--s',s+'%');
  document.documentElement.style.setProperty('--acc-strong',`hsl(${h} ${s}% ${L}%)`);
  document.documentElement.style.setProperty('--glow',`hsl(${h} ${s}% ${L}% / .38)`);
})();
</script>

<link rel="stylesheet" href="/css/01-theme.css">
<link rel="stylesheet" href="/css/02-layout.css">
<link rel="stylesheet" href="/css/03-components.css">
<link rel="stylesheet" href="/css/05-login.css">
</head>
<body class="login-body">

<div class="login-theme-toggle">
  <button class="icon-btn" id="btnTheme" data-tip="Cambiar tema" type="button">
    <svg id="icoSun" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
    <svg id="icoMoon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>
</div>

<main class="login-wrap">
  <div class="login-box glass-deep">

    <div class="login-brand">
      <div class="login-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v20M2 12h20"/>
          <circle cx="12" cy="12" r="9"/>
        </svg>
      </div>
      <h1>CitasMédicas</h1>
      <p>Sistema de gestión de citas</p>
    </div>

    <form method="post" action="/login" class="login-form">
      <div class="field">
        <label for="email">Email</label>
        <input class="input" type="email" id="email" name="email" placeholder="tu@correo.com" required autofocus autocomplete="email">
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <input class="input" type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
      </div>

      <button class="btn btn-primary login-submit" type="submit">
        Entrar
      </button>
    </form>

    <div class="login-hints">
      <div class="login-hint-row"><span>Admin</span><code>admin@citasmedicas.local</code></div>
      <div class="login-hint-row"><span>Recepción</span><code>recepcion@citasmedicas.local</code></div>
    </div>
  </div>
</main>

<div class="toasts" id="toasts"></div>

<script src="/js/theme.js"></script>

<% unless flash.empty? %>
<script>
  (function(){
    var msgs = <%= flash.pendientes.to_json %>;
    Object.keys(msgs).forEach(function(k){
      var map = {success:'ok', error:'err', warning:'warn', info:'info'};
      var tipo = map[k] || 'info';
      var titulo = {ok:'Éxito', err:'Error', warn:'Atención', info:'Info'}[tipo];
      setTimeout(function(){
        var c = document.getElementById('toasts');
        if (!c) return;
        var el = document.createElement('div');
        el.className = 'toast glass-deep ' + tipo;
        el.innerHTML = '<div><b>' + titulo + '</b><p>' + msgs[k] + '</p></div>';
        c.appendChild(el);
        setTimeout(function(){ el.remove(); }, 4000);
      }, 150);
    });
  })();
</script>
<% end %>
</body>
</html>