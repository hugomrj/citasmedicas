<!-- views/layout/partials/_search_modal.erb -->
<div class="ov" id="searchOv" style="align-items: flex-start; padding-top: 10vh;">
  <div class="modal glass-deep" style="max-width: 600px; padding: 0; overflow: hidden;">
    
    <div style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--brd);">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-2)" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Buscar en el menú..." autocomplete="off">
      <kbd style="font-size: 0.65rem; color: var(--text-2); border: 1px solid var(--brd-2); padding: 0.2rem 0.4rem; border-radius: 4px;">ESC</kbd>
    </div>

    <ul id="searchResults" style="list-style: none; max-height: 300px; overflow-y: auto; padding: 0.5rem 0;">
      <li style="padding: 1rem; text-align: center; color: var(--text-2); font-size: 0.85rem;">Escribí para buscar...</li>
    </ul>

  </div>
</div>