<header class="topbar">
  <button class="icon-btn" id="btnSide" data-tip="Mostrar / ocultar menú">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
  </button>
  <nav class="crumbs">
    <span class="hide-m">CitasMédicas</span><span class="sep hide-m">/</span>
    <b><%= @crumb_here || 'Dashboard' %></b>
  </nav>

  <div class="notif-wrap">
    <button class="icon-btn" id="btnNotif" data-tip="Notificaciones">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      <span class="ping" id="notifPing" style="<%= avisos_pendientes_count > 0 ? '' : 'display:none' %>"></span>
    </button>
    <div class="notif-menu glass-deep" id="notifMenu">
      <div class="n-head">
        <b>Notificaciones</b>
        <a href="/avisos" class="n-mark">Ver todas</a>
      </div>
      <ul class="n-list" id="notifList">
        <% avisos_pendientes_lista.each do |a| %>
          <li class="n-item unread">
            <span class="n-dot"></span>
            <div class="n-body">
              <b><%= a.titulo %></b>
              <p><%= a.detalle %></p>
              <time><%= a.created_at.strftime('%d/%m %H:%M') %></time>
            </div>
          </li>
        <% end %>
        <% if avisos_pendientes_count == 0 %>
          <li class="n-empty show">
            <div class="fig"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
            <b>Todo al día</b>
            <p>No hay notificaciones nuevas.</p>
          </li>
        <% end %>
      </ul>
      <div class="n-empty" id="notifEmpty" style="display:none"><b>Sin notificaciones</b></div>
      <button id="btnMarkAll" style="display:none">Marcar todas</button>
    </div>
  </div>

  <button class="icon-btn" id="btnTheme" data-tip="Cambiar tema">
    <svg id="icoSun" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
    <svg id="icoMoon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>

  <div class="user-wrap">
    <button class="avatar-btn" id="avatarBtn" data-tip="Cuenta">
      <%= usuario_actual.nombre[0].to_s.upcase + usuario_actual.apellido[0].to_s.upcase %>
    </button>
    <span id="userBadge" class="badge" style="display:none">0</span>
    <div class="user-menu glass-deep" id="userMenu">
      <div class="u-head">
        <div class="u-avatar"><%= usuario_actual.nombre[0].to_s.upcase + usuario_actual.apellido[0].to_s.upcase %></div>
        <div class="u-info">
          <b><%= usuario_actual.nombre_completo %></b>
          <span><%= usuario_actual.email %></span>
        </div>
      </div>
      <div class="u-sep"></div>
      <a href="/perfil" class="u-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Mi perfil
      </a>
      <div class="u-sep"></div>
      <a href="/logout" class="u-item danger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        Cerrar sesión
      </a>
      <input type="color" id="customColor" value="#10b981" style="display:none">
    </div>
  </div>
</header>