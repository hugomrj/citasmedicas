<div class="page-head">
  <div>
    <h1>Agenda Diaria</h1>
    <p>Visualizá y gestioná los turnos del consultorio.</p>
  </div>
  <a href="/agenda/nueva" class="btn btn-primary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    <span>Nueva Cita</span>
  </a>
</div>






<!-- Cambiamos filters glass por toolbar -->
<div class="toolbar">
  <form method="get" action="/agenda" id="formFiltros" class="toolbar-form">
    <input type="hidden" name="status" value="<%= @status_actual %>">
    
    <div class="field">
      <!-- El CSS oculta este label visualmente, pero los lectores de pantalla lo leen -->
      <label for="fecha">Fecha</label>
      <input id="fecha" class="input" type="date" name="fecha" value="<%= @fecha_actual %>" onchange="this.form.submit()">
    </div>

    <div class="field">
      <label for="paciente">Paciente</label>
      <!-- El CSS oculta este select nativo para que no parpadee -->
      <select id="paciente" class="vanilla-select" name="paciente_id" onchange="this.form.submit()">
        <option value="">Paciente (Todos)</option>
        <% @pacientes_filtro.each do |p| %>
          <option value="<%= p.id %>" <%= @paciente_actual.to_s == p.id.to_s ? 'selected' : '' %>><%= p.nombre_completo %></option>
        <% end %>
      </select>
    </div>

    <div class="field">
      <label for="medico">Médico</label>
      <!-- El CSS oculta este select nativo para que no parpadee -->
      <select id="medico" class="vanilla-select" name="medico_id" onchange="this.form.submit()">
        <option value="">Médico (Todos)</option>
        <% @medicos_filtro.each do |m| %>
          <option value="<%= m.id %>" <%= @medico_actual.to_s == m.id.to_s ? 'selected' : '' %>><%= m.nombre_completo %></option>
        <% end %>
      </select>
    </div>
  </form>
</div>





<div class="panel glass">
  <div class="panel-head">
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
      <h2>Citas del día</h2>
      



      <div class="tabs" id="listTabs">
        <button class="tab <%= @status_actual == 'todas' ? 'on' : '' %>" onclick="cambiarTab('todas')">
          Todas <span class="t-count"><%= @contador_todas %></span>
        </button>
        <button class="tab <%= @status_actual == 'pendientes' ? 'on' : '' %>" onclick="cambiarTab('pendientes')">
          Pendientes <span class="t-count"><%= @contador_pendientes %></span>
        </button>
        <button class="tab <%= @status_actual == 'atendidas' ? 'on' : '' %>" onclick="cambiarTab('atendidas')">
          Atendidas <span class="t-count"><%= @contador_atendidas %></span>
        </button>
        <button class="tab <%= @status_actual == 'no_asistio' ? 'on' : '' %>" onclick="cambiarTab('no_asistio')">
          No Asistió <span class="t-count"><%= @contador_no_asistio %></span>
        </button>
        <button class="tab <%= @status_actual == 'canceladas' ? 'on' : '' %>" onclick="cambiarTab('canceladas')">
          Canceladas <span class="t-count"><%= @contador_canceladas %></span>
        </button>
      </div>


    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Hora</th>
          <th>Paciente</th>
          <th>Médico</th>
          <th>Motivo</th>
          <th class="c-state">Estado</th>
          <th class="c-actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @citas.empty? %>
          <tr>
            <td colspan="6" style="text-align:center; padding: 2rem; color: var(--text-2);">No se encontraron citas.</td>
          </tr>
        <% else %>
          <% @citas.each do |cita| %>
            <tr>
              <td><b><%= cita.fecha_hora.strftime('%H:%M') %></b></td>
              <td class="cell-name"><b><%= cita.paciente.nombre_completo %></b></td>
              <td><%= cita.medico.nombre_completo %></td>
              <td><span style="color:var(--text-2); font-size: 0.8rem;"><%= cita.motivo || '-' %></span></td>
              <td class="c-state">
                <span class="status <%= cita.estado == 'cancelada' || cita.estado == 'no_asistio' ? 'off' : 'ok' %>">
                  <%= cita.estado.capitalize.gsub('_', ' ') %>
                </span>
              </td>
              <td class="c-actions">
                <% if cita.estado != 'cancelada' && cita.estado != 'atendida' %>
                  <div class="row-actions">
                    <button class="kebab" data-kebab>
                      <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
                    </button>
                    <div class="dd glass-deep">
                      
                      <!-- Editar Cita -->
                      <button type="button" onclick="window.location.href='/agenda/<%= cita.id %>/editar'">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                        Editar / Reprogramar
                      </button>

                      <!-- Confirmar Cita -->
                      <% if cita.estado == 'pendiente' %>
                        <form method="post" action="/agenda/<%= cita.id %>/estado" style="margin:0; padding:0;">
                          <input type="hidden" name="nuevo_estado" value="confirmada">
                          <button type="submit">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            Confirmar Asistencia
                          </button>
                        </form>
                      <% end %>

                      <!-- Atendida -->
                      <form method="post" action="/agenda/<%= cita.id %>/estado" style="margin:0; padding:0;">
                        <input type="hidden" name="nuevo_estado" value="atendida">
                        <button type="submit">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                          Marcar Atendida
                        </button>
                      </form>

                      <!-- No Asistió -->
                      <form method="post" action="/agenda/<%= cita.id %>/estado" style="margin:0; padding:0;">
                        <input type="hidden" name="nuevo_estado" value="no_asistio">
                        <button type="submit">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
                          No Asistió
                        </button>
                      </form>

                      <div class="u-sep" style="margin: 0.2rem 0;"></div>

                      <!-- Cancelar Cita -->
                      <form method="post" action="/agenda/<%= cita.id %>/estado" style="margin:0; padding:0;">
                        <input type="hidden" name="nuevo_estado" value="cancelada">
                        <input type="hidden" name="motivo" value="Cancelada desde agenda">
                        <button type="submit" class="danger">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
                          Cancelar Cita
                        </button>
                      </form>

                    </div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function cambiarTab(status) {
    const url = new URL(window.location.href);
    url.searchParams.set('status', status);
    window.location.href = url.toString();
  }
</script>