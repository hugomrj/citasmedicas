<div class="page-head">
  <div>
    <h1>Dashboard Estático</h1>
    <p>Si ves esto con tarjetas y colores, el CSS funciona perfecto.</p>
  </div>
  <button class="btn btn-primary">
    <span>Botón de prueba</span>
  </button>
</div>

<div class="dash-grid">
  <div class="dash-card glass dc-3 metric">
    <span class="lbl">Citas hoy</span>
    <strong class="val">5</strong>
    <div class="metric-foot"><span class="delta up">↗ +2</span></div>
  </div>

  <div class="dash-card glass dc-3 metric">
    <span class="lbl">Pacientes</span>
    <strong class="val">10</strong>
  </div>

  <div class="dash-card glass dc-3 metric">
    <span class="lbl">Médicos</span>
    <strong class="val">2</strong>
  </div>

  <div class="dash-card glass dc-3 metric">
    <span class="lbl">Avisos</span>
    <strong class="val">0</strong>
  </div>
</div>

<div class="dash-grid">
  <div class="dash-card glass dc-12">
    <div class="chart-head">
      <h3>Tabla de prueba estática</h3>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Médico</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><b>09:00</b></td>
            <td>María López</td>
            <td>Ana Gómez</td>
            <td><span class="status ok">Pendiente</span></td>
          </tr>
          <tr>
            <td><b>10:00</b></td>
            <td>Juan Martínez</td>
            <td>Carlos Pérez</td>
            <td><span class="status off">Cancelada</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>