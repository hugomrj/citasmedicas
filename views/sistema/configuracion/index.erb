<div class="page-head">
  <div>
    <h1>Configuración del Sistema</h1>
    <p>Parámetros globales de agendamiento y reservas.</p>
  </div>
</div>

<div class="panel glass form-panel">
  <form method="post" action="/configuracion">
    <div class="form-grid">
      
      <div class="field fw-2">
        <label for="horizonte">Horizonte de reserva (días)</label>
        <input class="input" type="number" id="horizonte" name="horizonte" value="<%= @horizonte %>" min="1" required>
        <div class="hint">Hasta cuántos días a futuro puede agendar un paciente (por defecto 60).</div>
      </div>

      <div class="field fw-2">
        <label for="anticipacion">Anticipación mínima (horas)</label>
        <input class="input" type="number" id="anticipacion" name="anticipacion" value="<%= @anticipacion %>" min="0" required>
        <div class="hint">Con cuánta anticipación se puede sacar un turno (por defecto 2). Poné 0 para permitir turnos "para ahora".</div>
      </div>

    </div>

    <div class="form-sep"></div>

    <div class="form-actions">
      <span class="spacer"></span>
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
        Guardar Configuración
      </button>
    </div>
  </form>
</div>