<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="c-id">ID</th>
        <th>Nombre de la Especialidad</th>
        <th class="c-actions">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if @especialidades.empty? %>
        <tr>
          <td colspan="3" style="text-align:center; padding: 2rem; color: var(--text-2);">
            No se encontraron especialidades.
          </td>
        </tr>
      <% else %>
        <% @especialidades.each do |esp| %>
          <tr>
            <td class="c-id">
              <a href="/especialidades/<%= esp.id %>/editar" class="id-cell">#<%= esp.id %></a>
            </td>
            <td class="cell-name">
              <b><%= esp.nombre %></b>
            </td>
            <td class="c-actions">
              <div class="row-actions">
                <button class="kebab" data-kebab>
                  <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
                </button>
                <div class="dd glass-deep">
                  <button type="button" onclick="window.location.href='/especialidades/<%= esp.id %>/editar'">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                    Editar
                  </button>
                  
                  <!-- Formulario corregido apuntando a /eliminar por POST -->
                  <form method="post" action="/especialidades/<%= esp.id %>/eliminar" style="margin: 0; padding: 0;">
                    <button type="submit" class="danger" style="width: 100%;">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
                      Eliminar
                    </button>
                  </form>
                </div>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="panel-foot">
  <span>
    Mostrando <%= @especialidades.size %> de <%= numero_abreviado(@total_registros) %> registros
  </span>
  
  <div class="pager" id="paginador">
    <button <%= @pagina_actual <= 1 ? 'disabled' : '' %> data-page="<%= @pagina_actual - 1 %>">‹</button>
    <% (1..@total_paginas).each do |p| %>
      <% if p == 1 || p == @total_paginas || (p >= @pagina_actual - 1 && p <= @pagina_actual + 1) %>
        <button class="<%= p == @pagina_actual ? 'on' : '' %>" data-page="<%= p %>"><%= p %></button>
      <% elsif p == @pagina_actual - 2 || p == @pagina_actual + 2 %>
        <button disabled>...</button>
      <% end %>
    <% end %>
    <button <%= @pagina_actual >= @total_paginas ? 'disabled' : '' %> data-page="<%= @pagina_actual + 1 %>">›</button>
  </div>
</div>