<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="c-id">ID</th>
        <th>Paciente</th>
        <th>Teléfono</th>
        <th>Cédula</th>
        <th class="c-state">Estado</th>
        <th class="c-actions">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if @pacientes.empty? %>
        <tr>
          <td colspan="6" style="text-align:center; padding: 2rem; color: var(--text-2);">
            No se encontraron pacientes.
          </td>
        </tr>
      <% else %>
        <% @pacientes.each do |pac| %>
          <tr>
            <td class="c-id">
              <a href="/pacientes/<%= pac.id %>/editar" class="id-cell">#<%= pac.id %></a>
            </td>
            <td class="cell-name">
              <b><%= pac.nombre_completo %></b>
              <span><%= pac.email || 'Sin correo' %></span>
            </td>
            <td><%= pac.telefono %></td>
            <td><%= pac.cedula || '-' %></td>
            <td class="c-state">
              <span class="status <%= pac.archivado ? 'off' : 'ok' %>">
                <%= pac.archivado ? 'Inactivo' : 'Activo' %>
              </span>
            </td>
            <td class="c-actions">
              <div class="row-actions">
                <button class="kebab" data-kebab>
                  <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
                </button>
                <div class="dd glass-deep">
                  <button type="button" onclick="window.location.href='/pacientes/<%= pac.id %>/editar'">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                    Editar
                  </button>
                  
                  <form method="post" action="/pacientes/<%= pac.id %>/archivar" style="margin: 0; padding: 0;">
                    <input type="hidden" name="_method" value="PATCH">
                    <button type="submit" class="danger" style="width: 100%;">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
                      Archivar
                    </button>
                  </form>
                </div>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>