<div class="page-head">
  <div>
    <h1><%= @paciente.new? ? 'Nuevo Paciente' : 'Editar Paciente' %></h1>
    <p>Completá los datos personales del paciente.</p>
  </div>
</div>

<div class="panel glass form-panel">
  <form method="post" action="<%= @paciente.new? ? '/pacientes' : "/pacientes/#{@paciente.id}" %>">
    <% if !@paciente.new? %>
      <input type="hidden" name="_method" value="PUT">
    <% end %>

    <div class="form-grid">
      <!-- Fila 1: Nombre y Apellido -->
      <div class="field fw-2">
        <label for="nombre">Nombre</label>
        <input class="input" type="text" id="nombre" name="nombre" value="<%= @paciente.nombre %>" required>
      </div>

      <div class="field fw-2">
        <label for="apellido">Apellido</label>
        <input class="input" type="text" id="apellido" name="apellido" value="<%= @paciente.apellido %>" required>
      </div>

      <!-- Fila 2: Teléfono y Cédula -->
      <div class="field fw-2">
        <label for="telefono">Teléfono</label>
        <input class="input" type="text" id="telefono" name="telefono" value="<%= @paciente.telefono %>" required>
      </div>

      <div class="field fw-2">
        <label for="cedula">Cédula <span class="opt">(opcional)</span></label>
        <input class="input" type="text" id="cedula" name="cedula" value="<%= @paciente.cedula %>">
      </div>

      <!-- Fila 3: Correo y Estado -->
      <div class="field fw-2">
        <label for="email">Correo Electrónico <span class="opt">(opcional)</span></label>
        <input class="input" type="text" id="email" name="email" value="<%= @paciente.email %>">
      </div>

      
      <!-- Switch de Estado al lado del Correo -->
      <% if !@paciente.new? %>
        <div class="field fw-2">
          <label for="fActive">Estado</label>
          <label class="switch-row">
            <input type="checkbox" id="fActive" name="activo" class="switch" value="1" <%= !@paciente.archivado ? 'checked' : '' %>>
            <span class="switch-state"></span>
          </label>
        </div>
      <% end %>
    </div>

    <div class="form-sep"></div>

    <div class="form-actions">
      <span class="spacer"></span>
      <a href="/pacientes" class="btn btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
        <span>Guardar Paciente</span>
      </button>
    </div>
  </form>
</div>